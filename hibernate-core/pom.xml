	<!-- 
      // Careful with these properties, some are required by CreateVersionFile
      // application. Specifically:
      //
      // - java.version        - defines minimum JDK compatibility supported.
      // - jpa.version         - defines the JPA compatibiloty
      // - hibernate.version   - used to create JarVersionInfo.java
      //
      // All classes are built for JDK 17, the same as Hibernate 7.
      // Only a minimal subset of Spring is used for testing and for Spring's
	  // JdbcTemplate class.  Spring Boot is NOT used.
      -->
