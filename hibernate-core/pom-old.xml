	<!-- 
      // Careful with these properties, some are required by CreateVersionFile
      // application. Specifically:
      //
      // - java.version        - defines minimum JDK compatibility supported.
      // - jpa.version         - defines the JPA compatibiloty
      // - hibernate.version   - used to create JarVersionInfo.java
      //
      // All classes are built for JDK 17, the same as Hibernate 7.
      // Only a minimal subset of Spring is used for testing and for Spring's
	  // JdbcTemplate class.  Spring Boot is NOT used.
      -->
	<properties>
		<!-- Maven properties -->
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<!-- Custom properties - used by plugins and/or CreateVersionFile -->
		<asciidoc.file>README.adoc</asciidoc.file>
		<base.package>com.nuodb.hibernate</base.package>
		<java.version>25</java.version>
		<javadoc.notstrict>-Xdoclint:none</javadoc.notstrict>
		<jpa.version>3.2.0</jpa.version>

		<!-- JAN 26: Latest supported versions are  7.0.10, 7.1.14, 7.2.1 -->
		<minimum.supported.hibernate.minor.version>0</minimum.supported.hibernate.minor.version>
		<maximum.supported.hibernate.minor.version>2</maximum.supported.hibernate.minor.version>
		<supported.hibernate.versions>7.0, 7.1, 7.2</supported.hibernate.versions>

		<!-- Dependencies for this JAR and its tests -->
		<checkerframework.version>3.52.0</checkerframework.version>
		<datasource-proxy>1.8.1</datasource-proxy>
		<hibernate.validator.version>8.0.1.Final</hibernate.validator.version>
		<hibernate.version>7.2.4.Final</hibernate.version>
		<h2.version>2.3.232</h2.version>
		<hikari.version>7.0.1</hikari.version>
		<jackson.version>2.9.5</jackson.version>
		<jakarta.enterprise.version>4.1.0</jakarta.enterprise.version>
		<jakarta.json.version>2.0.1</jakarta.json.version>
		<jboss.logging.version>3.6.1.Final</jboss.logging.version>
		<jboss.logging.tool.version>3.0.4.Final</jboss.logging.tool.version>
		<joda.time.version>2.12.7</joda.time.version>
		<junit5.version>5.14.3</junit5.version>
		<junit.platform.version>1.14.3</junit.platform.version>
		<logback.version>1.4.14</logback.version>
		<nuodb.common.version>2.1.0</nuodb.common.version>
		<nuodb.jdbc.version>24.2.1</nuodb.jdbc.version>
		<!-- <nuodb.jdbc.version>24.2.2</nuodb.jdbc.version> -->
		<oracle.version>23.26.0.0.0</oracle.version>  <!-- was 23.7.0.25.01 -->
		<p6spy.version>3.9.1</p6spy.version>
		<shrinkwrap.version>1.2.6</shrinkwrap.version>
		<slf4j.version>2.0.17</slf4j.version>
		<spring.version>5.3.39</spring.version>
		<stefanbirkner.rules.version>1.19.0</stefanbirkner.rules.version>
		<weld.version>5.1.3.Final</weld.version>
	</properties>

	<distributionManagement>
